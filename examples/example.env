# Copy to ".env" in this directory (see examples/README.md)
BITMESH_CONSUMER_KEY=
BITMESH_CONSUMER_SECRET=

# Optional — override paths for tryon_example.py (defaults: ../tests/fixtures/*.png)
# BITMESH_TRYON_PERSON_IMAGE=
# BITMESH_TRYON_TOP_IMAGE=
# BITMESH_TRYON_BOTTOM_IMAGE=

# Optional — tryon_poll_example.py only (polling + downloaded result file)
# BITMESH_TRYON_POLL_SECONDS=60
# BITMESH_TRYON_POLL_INTERVAL=3
# BITMESH_TRYON_OUTPUT=/tmp/tryon_result.png
